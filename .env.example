# Database Configuration
DATABASE_URL="file:./dev.db"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
NEXT_PUBLIC_CLERK_ENABLED=true

# Clerk Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Rate Limiting Configuration (Cost-optimized to stay within AWS Free Tier quotas)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=30
RATE_LIMIT_MUTATION_MAX=10
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_PAGE_MAX=60
RATE_LIMIT_ACTION_MAX=10

# Real AI Feynman Review & Note Evaluation (Optional but recommended)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative AI providers supported:
# OPENAI_API_KEY=your_openai_key_here
# GROQ_API_KEY=your_groq_key_here

# Optional: Distributed Upstash Redis for multi-instance deployments
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token
